# ctf-status of test instance 1 (DESIGN.md §9). Sample values for the docker/
# test setup only: NOT secrets.
CTF_ACCESS_CODE=test1
CTF_GATE_SECRET=test-gate-secret-lab-1-not-secret-0123456789
CTF_INTERNAL_TOKEN=test-internal-token-lab-1-not-secret
# >>> false so the door also opens on http://<ip>/ from another machine: a
# browser refuses a Secure cookie over plain HTTP, except on localhost
# (DESIGN.md §5.3). With false, the access code and the cookie cross the
# network in the clear: a closed lab only. On a node with HTTPS: true.
CTF_COOKIE_SECURE=false
