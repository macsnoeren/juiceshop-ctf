# juiceshop-ctf: Juice Shop and ctf-node in ONE image
#
# Build context is the REPOSITORY ROOT:
#
#   docker build -f deploy/docker/Dockerfile.node --build-arg VERSION=$(git describe --tags --always --dirty) -t juiceshop-ctf .
#   (or: make images)
#
# Run it anywhere — a laptop, a VM, a Flatcar node:
#
#   docker run -d --name juiceshop-ctf -p 80:80 -p 8080:8080 -v juiceshop-ctf:/var/lib/ctf \
#     --cap-drop ALL --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges \
#     juiceshop-ctf
#
#   ctf-node (the keeper)   uid 0, PID 1, SETUID+SETGID only: starts the two below, nothing else
#    ├─ node build/app.js   uid 65532 (Juice Shop's own user), no capabilities
#    └─ ctf-node -serve     uid 10001, no capabilities: :80 the shop, :8080 the page,
#                           /var/lib/ctf/node.db (0700)
#
# WHAT IS UNUSUAL HERE:
#
#   - The image runs as ROOT on purpose: the keeper must start Juice Shop
#     and ctf-node as their own users. It holds only SETUID and SETGID, reads
#     no network input, and ctf-node refuses to start if it has any privilege.
#   - TWO PORTS: the shop on 80, the student's page on 8080. Two origins, so
#     script in Juice Shop (which has XSS on purpose) cannot read the page
#     or press its buttons. Behind a port mapping, CTF_SHOP_PORT and
#     CTF_PAGE_PORT say which ports the browser uses, for the links.
#   - CMD is reset: the base image's CMD is Juice Shop's script, which would
#     otherwise be passed to ctf-node as an argument.
#   - Juice Shop runs in UNSAFE MODE (NODE_ENV=unsafe, its safety mode off),
#     so the challenges it disables in Docker are on. ctf-node sets it for
#     Juice Shop when it starts it; an ENV here or on `docker run` does not
#     reach Juice Shop. Its code execution stays inside uid 65532.
#   - The root filesystem cannot be read-only: Juice Shop rewrites its own
#     database, translations and frontend under /juice-shop on every start.
#     Only /juice-shop/logs is worth a tmpfs.
#   - CTF_CENTRAL_URL, the central server a join goes to, is the build arg
#     CENTRAL_URL: not a secret, and the student page can change it before
#     joining. Empty (the default) means the image knows no central server:
#     the student types its address on the page, or plays on the VM alone.
#     A release gets it from the repository variable CENTRAL_URL
#     (.github/workflows/release.yml). Nothing else in the image differs
#     between students.
#
# >>> Upgrading Juice Shop is a new FROM tag, the fixtures and the catalogue
# captured again (internal/juiceshop/testdata/README.md), and scripts/e2e.sh.

FROM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/macsnoeren/juiceshop-ctf/internal/version.Version=${VERSION}" \
      -o /out/ctf-node ./cmd/ctf-node \
 && mkdir -p /out/var/lib/ctf

FROM bkimminich/juice-shop:v20.3.0@sha256:cea5a4af4aacee498c491491af0408934ec81d004035c0a02ef3e54395e3bf27
# ctf-node is GPL-3.0-or-later; Juice Shop, the base image, keeps its MIT
# licence. The licence text travels with the binary, as the GPL asks.
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later AND MIT" \
      org.opencontainers.image.source="https://github.com/macsnoeren/juiceshop-ctf"
COPY LICENSE /usr/share/licenses/juiceshop-ctf/LICENSE
COPY --from=build /out/ctf-node /ctf-node
# The node's directory: 10001 and 0700. A named volume mounted here is
# initialised from it, ownership and mode included.
COPY --from=build --chown=10001:10001 --chmod=0700 /out/var/lib/ctf /var/lib/ctf
ARG CENTRAL_URL=
ENV CTF_CENTRAL_URL=${CENTRAL_URL}
USER 0:0
WORKDIR /
EXPOSE 80 8080
VOLUME /var/lib/ctf
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --start-interval=2s --retries=3 CMD ["/ctf-node", "-healthcheck"]
ENTRYPOINT ["/ctf-node"]
CMD []
