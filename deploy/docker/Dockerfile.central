# ctf-central: games, joins, reports, the boards and admin
#
# Build context is the REPOSITORY ROOT, not this directory:
#
#   docker build -f deploy/docker/Dockerfile.central -t juiceshop-ctf-central:latest .
#
# The result is FROM scratch: one static binary, CA certificates, a passwd
# line for the non-root user, nothing else. There is no shell to exec into and
# nothing to patch but the binary itself. The HEALTHCHECK therefore runs the
# binary's own -healthcheck flag (internal/health), not curl.
#
# MULTI-PLATFORM without emulation: the Go stage runs on the BUILD machine's
# platform and cross-compiles for the target (GOOS/GOARCH from buildx's
# TARGETOS/TARGETARCH), which works because the SQLite driver is pure Go
# (modernc.org/sqlite, no cgo). The release workflow
# (.github/workflows/release.yml) builds linux/amd64 and linux/arm64 this
# way; a plain `docker build` builds for the machine it runs on.

FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
ARG VERSION=dev
# No defaults: buildx fills these in, and a default here would WIN over its
# value (an "arm64" image with an amd64 binary in it). Empty — a builder
# without BuildKit — means Go builds for the machine it runs on.
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X github.com/macsnoeren/juiceshop-ctf/internal/version.Version=${VERSION}" \
      -o /out/ctf-central ./cmd/ctf-central \
 && mkdir -p /out/rootfs/etc \
 && echo 'ctf:x:10001:10001:ctf:/nonexistent:/sbin/nologin' > /out/rootfs/etc/passwd \
 && echo 'ctf:x:10001:' > /out/rootfs/etc/group \
 && mkdir -p /out/rootfs/data

FROM scratch
# The licence text travels with the binary, as the GPL asks.
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/macsnoeren/juiceshop-ctf"
COPY LICENSE /usr/share/licenses/juiceshop-ctf/LICENSE
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/rootfs/etc/passwd /out/rootfs/etc/group /etc/
# The state directory, owned by the runtime user. A named volume mounted here
# is initialised from it, ownership included, so the non-root process can
# write to a fresh volume without a chown step.
COPY --from=build --chown=10001:10001 /out/rootfs/data /data
COPY --from=build /out/ctf-central /ctf-central
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --start-interval=2s --retries=3 CMD ["/ctf-central", "-healthcheck"]
ENTRYPOINT ["/ctf-central"]
