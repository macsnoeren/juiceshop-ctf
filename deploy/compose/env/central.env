# ctf-central in the docker/ test setup. CTF_SEED creates the two test
# instances with the tokens in agent-1.env and agent-2.env, so the test needs
# no trip through /admin/. A real server has no CTF_SEED: instances and their
# tokens are created in /admin/ (DESIGN.md §8.4).
CTF_SEED=lab-1=test-central-token-lab-1-not-secret,lab-2=test-central-token-lab-2-not-secret
