# ctf-agent of test instance 2 (DESIGN.md §9). Sample values for the docker/
# test setup only: NOT secrets, and never to be reused on a real node, where
# this file comes from nodes/<node>/keys/juiceshop-ctf/agent.env.
CTF_INSTANCE_ID=lab-2
CTF_CENTRAL_URL=http://ctf-central:8080/leaderboard
# Must match the token for lab-2 in central.env (CTF_SEED).
CTF_CENTRAL_TOKEN=test-central-token-lab-2-not-secret
# Must match CTF_INTERNAL_TOKEN in status-2.env.
CTF_INTERNAL_TOKEN=test-internal-token-lab-2-not-secret
